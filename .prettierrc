{
  "printWidth": 100,
  "tabWidth": 2,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "endOfLine": "lf",
  "useTabs": false,
  "jsxSingleQuote": true,
  "bracketSpacing": true,
  "arrowParens": "always",
  "proseWrap": "always",

  "plugins": ["@trivago/prettier-plugin-sort-imports", "prettier-plugin-tailwindcss"],
  "importOrder": [
    "react",
    "next",
    "<THIRD_PARTY_MODULES>",
    "^(@App|@Components|@Hooks|@Lib|@Public)/.*$",
    "^(\\.|\\.\\.)/(.(?!.(css|scss)))*$",
    "^(@Css)/.*$",
    "\\.(css|scss)$"
  ],
  "importOrderSeparation": true,
  "importOrderSortSpecifiers": true,
  "importOrderCaseInsensitive": true
}
